# ============================================================================
# ÓTICA VENTARA — VARIÁVEIS DE AMBIENTE
# Preencha estas variáveis no seu arquivo .env.local e nas configurações da Vercel.
# NUNCA comite chaves privadas ou valores secretos no repositório.
# ============================================================================

# Supabase (Projeto Oficial)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-privada-aqui

# URL da Aplicação
NEXT_PUBLIC_SITE_URL=https://otica-ventara-murex.vercel.app

# Integrações Futuras de Gateway de Pagamento (Checkout)
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_WEBHOOK_SECRET=
